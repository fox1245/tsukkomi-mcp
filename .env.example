# OpenRouter is required for default hybrid retrieval, embeddings, and opt-in synthetic JEV classification; contract audits remain deterministic and local.
OPENROUTER_API_KEY=

# Optional overrides
# This dotenv is read only by the MCP server, from its working directory, at the lowest precedence.
# Lifecycle hooks (AGY, Claude Code) never read it; they use the environment and the user TOML.
# SELF_DIRECT_CODEX_SESSIONS_DIR=
# CODEX_SESSIONS_DIR=
# Default provider for sync/audit when tool arg omitted: codex | grokbot | omp | agy | claude
# SELF_DIRECT_SESSION_PROVIDER=codex
# Cursor / Grok Bot agent-transcripts root(s). Empty = disabled.
# Example: /path/to/agent-transcripts
# Multiple roots (mirrors): separate with ; or OS pathsep
# SELF_DIRECT_GROKBOT_TRANSCRIPTS_DIR=/path/to/agent-transcripts
# Windows copy/mount example:
# SELF_DIRECT_GROKBOT_TRANSCRIPTS_DIR=C:\data\agent-transcripts
# Default index: ~/.self_direct_index, outside the checkout/installed package.
# Preserve existing index data by setting its current absolute directory.
# SELF_DIRECT_INDEX_DIR=/path/to/existing-or-managed/index
# User path settings can instead live in ~/.config/tsukkomi-mcp/config.toml [paths].
# Select a different TOML with SELF_DIRECT_CONFIG_FILE in the process environment,
# not in this dotenv. Explicit arguments/environment override TOML paths.
# OMP remote retrieval default: set the authorized key-file and native vector paths below.
# Explicit offline-only mode: SELF_DIRECT_LOCAL_ONLY=true (no key or vector library needed).
# SELF_DIRECT_OMP_SESSIONS_DIR=/path/to/omp/agent/sessions
# OMP extension also needs TSUKKOMI_OMP_MONITOR=1, TSUKKOMI_OMP_PYTHON,
# and optionally TSUKKOMI_OMP_SOURCE in its private runtime environment.
SELF_DIRECT_USE_FAKE_EMBEDDER=false
# Demonstrations only; new installations have no contracts by default.
# SELF_DIRECT_SEED_EXAMPLE_CONTRACTS=false
# Bounded index wait / local audit response budget (seconds).
# SELF_DIRECT_LOCK_WAIT_TIMEOUT_SEC=1
# SELF_DIRECT_AUDIT_TIMEOUT_SEC=8
# SELF_DIRECT_REQUEST_TIMEOUT_SEC=45
# Upper bound for per-call timeout_ms and the GraphRAG update budget (seconds).
# SELF_DIRECT_MAX_TOOL_TIMEOUT_SEC=600
# SELF_DIRECT_GRAPH_UPDATE_TIMEOUT_SEC=300
# Who extracts for run_neograph_update: openrouter (default; an OpenRouter model) or host, which disables that tool
# (extractor_disabled; the key and the network are not touched). The tools graph_next_batch and graph_submit_batch,
# where the calling agent extracts, work with either value and with SELF_DIRECT_LOCAL_ONLY=true. README, "Host-side
# GraphRAG extraction".
# SELF_DIRECT_GRAPH_EXTRACTOR=openrouter
# Incremental audits keep per-contract monitor state in the index and fold in only appended events (README,
# "Incremental audits"). SELF_DIRECT_AUDIT_INCREMENTAL=false evaluates every audit over the whole session.
# SELF_DIRECT_AUDIT_INCREMENTAL=true
# How often the full evaluator also runs beside the incremental one and the two are compared (a difference returns the
# full result and disables that contract's incremental path). adaptive (default): 1/4 of the audits at first, thinning
# to 1/32 as comparisons keep matching, plus forced comparisons (after a rebuild, for a violation, for a high-risk
# contract). An integer pins the fixed rate: 1 = every audit, 0 = only the forced comparisons, N = about one in N.
# README, "Incremental audits".
# SELF_DIRECT_AUDIT_SHADOW_EVERY=adaptive
# Resident servers (the daemon, the stdio server) compare the latest state of a session with a full evaluation after this
# many idle seconds (0 = off). Hook processes never do.
# SELF_DIRECT_AUDIT_SHADOW_IDLE_SEC=2
# Journal mode of the authority databases meta.sqlite and agy-receipts.sqlite: delete (default: the rollback journal) or
# auto (write-ahead logging on a verified local file system, the rollback journal elsewhere). Always synchronous=FULL.
# Faster for a resident process (the daemon, the stdio server), not for standalone command hooks.
# README, "SQLite journal mode, index files and backups".
# SELF_DIRECT_SQLITE_JOURNAL=delete
# Concurrent heavy tool calls per server process (sync, audit, search, hooks).
# SELF_DIRECT_MAX_CONCURRENT_CALLS=4
# Largest decompressed size (bytes) a zstd-compressed Codex session (rollout-*.jsonl.zst) may declare.
# SELF_DIRECT_MAX_DECOMPRESSED_SESSION_BYTES=4294967296
# Session roots (defaults: ~/.codex/sessions, ~/.omp/sessions, ~/.claude/projects).
# Claude Code projects root. Default: $CLAUDE_CONFIG_DIR/projects when CLAUDE_CONFIG_DIR is set,
# otherwise ~/.claude/projects. This variable overrides both (TOML claude_projects_dir sits between).
# SELF_DIRECT_CLAUDE_PROJECTS_DIR=/absolute/path/to/.claude/projects
# Claude Code hook policy: confirmed_only (default: a confirmed violation denies, suspicious asks),
# advisory (never gates), or enforced (strict opt-in: an unverifiable PreToolUse is denied).
# Hook errors fail open in every mode. scripts/install_claude_hooks.py writes this into the
# Claude Code settings env, which is where the hook commands see it.
# SELF_DIRECT_CLAUDE_ENFORCEMENT=confirmed_only
# SELF_DIRECT_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# SELF_DIRECT_EMBEDDING_DIM=1024
# SELF_DIRECT_RETRIEVE_TOP_K=20
# SELF_DIRECT_RRF_K=60

# Normal runtime: native sqliteai/sqlite-vector, with no automatic NumPy fallback.
SELF_DIRECT_DENSE_BACKEND=sqlite-vector
# Run scripts/setup_sqlite_vector.py, then set the absolute DLL/SO/dylib path.
# SELF_DIRECT_SQLITE_VECTOR_PATH=C:/path/to/native/vector.dll
# Reuse one authorized dotenv file containing OPENROUTER_API_KEY; never copy the key into Codex config.
# The configured file is authoritative: missing/keyless files never fall back to environment keys.
# Without a configured file, the shared OPENROUTER_API_KEY setting/environment is used.
# Ordinary working-directory .env values follow normal Settings precedence.
# Repository/package .env files are not automatically authoritative key files.
# SELF_DIRECT_OPENROUTER_API_KEY_FILE=/path/to/authorized/.env

# AGY evidence roots are app-data directories containing brain/<UUID>/.../logs.
# Defaults cover Antigravity 2.0, CLI, and IDE under the current user's .gemini.
# SELF_DIRECT_AGY_APP_DATA_DIRS=["/path/to/antigravity-cli"]
# AGY hook policy: confirmed_only (default: a confirmed violation denies, suspicious force-asks),
# advisory (never blocks), enforced (strict opt-in: an unverifiable PreToolUse is denied).
# Hook errors fail open in every mode.
# SELF_DIRECT_AGY_ENFORCEMENT=confirmed_only

# Optional owner-approved workflow. Keep these paths outside agent write authority.
# TSUKKOMI_WORKFLOW_APPROVAL=/path/to/read-only/approval
# TSUKKOMI_WORKFLOW_STATE=/path/to/private/workflow-state
# TSUKKOMI_LEAN=/path/to/trusted/lean
# TSUKKOMI_BWRAP=/path/to/trusted/bwrap
# Workflow classification uses the same OpenRouter key settings above; no separate TypeSafe key.
# Pinned model: typesafe/jev-1.13; canonical response: typesafe/jev-1.13-20260917.

# Source integrity. A fast (hook-time) check compares the tail block, the latest blocks and a random sample with their
# stored 1 MiB block digests instead of re-hashing the whole session file. See README "Source integrity".
# SELF_DIRECT_INTEGRITY_FAST_RECENT_BLOCKS=4
# SELF_DIRECT_INTEGRITY_FAST_SAMPLE_BLOCKS=8
# A fast check is allowed only this many seconds after the last full verification (0: always full).
# SELF_DIRECT_INTEGRITY_FULL_VERIFY_INTERVAL_SEC=300
# Resident servers verify watched sources in full on one background thread while idle; hooks never do.
# SELF_DIRECT_INTEGRITY_BACKGROUND_VERIFY=true
# SELF_DIRECT_INTEGRITY_BACKGROUND_IDLE_SEC=2
# SELF_DIRECT_INTEGRITY_BACKGROUND_MAX_SCANS=1
