# OpenRouter is required for default hybrid retrieval, embeddings, and opt-in synthetic JEV classification; contract audits remain deterministic and local.
OPENROUTER_API_KEY=

# Optional overrides
# SELF_DIRECT_CODEX_SESSIONS_DIR=
# CODEX_SESSIONS_DIR=
# Default provider for sync/audit when tool arg omitted: codex | grokbot | omp | agy
# SELF_DIRECT_SESSION_PROVIDER=codex
# Cursor / Grok Bot agent-transcripts root(s). Empty = disabled.
# Example: /path/to/agent-transcripts
# Multiple roots (mirrors): separate with ; or OS pathsep
# SELF_DIRECT_GROKBOT_TRANSCRIPTS_DIR=/path/to/agent-transcripts
# Windows copy/mount example:
# SELF_DIRECT_GROKBOT_TRANSCRIPTS_DIR=C:\data\agent-transcripts
# SELF_DIRECT_INDEX_DIR=.self_direct_index
# OMP remote retrieval default: set the authorized key-file and native vector paths below.
# Explicit offline-only mode: SELF_DIRECT_LOCAL_ONLY=true (no key or vector library needed).
# SELF_DIRECT_OMP_SESSIONS_DIR=/path/to/omp/agent/sessions
# OMP extension also needs TSUKKOMI_OMP_MONITOR=1, TSUKKOMI_OMP_PYTHON,
# and optionally TSUKKOMI_OMP_SOURCE in its private runtime environment.
SELF_DIRECT_USE_FAKE_EMBEDDER=false
# Demonstrations only; new installations have no contracts by default.
# SELF_DIRECT_SEED_EXAMPLE_CONTRACTS=false
# Bounded index wait / local audit response budget (seconds).
# SELF_DIRECT_LOCK_WAIT_TIMEOUT_SEC=1
# SELF_DIRECT_AUDIT_TIMEOUT_SEC=8
# SELF_DIRECT_REQUEST_TIMEOUT_SEC=45
# SELF_DIRECT_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# SELF_DIRECT_EMBEDDING_DIM=1024
# SELF_DIRECT_RETRIEVE_TOP_K=20
# SELF_DIRECT_RRF_K=60

# Normal runtime: native sqliteai/sqlite-vector, with no automatic NumPy fallback.
SELF_DIRECT_DENSE_BACKEND=sqlite-vector
# Run scripts/setup_sqlite_vector.py, then set the absolute DLL/SO/dylib path.
# SELF_DIRECT_SQLITE_VECTOR_PATH=C:/path/to/native/vector.dll
# Reuse one authorized dotenv file containing OPENROUTER_API_KEY; never copy the key into Codex config.
# The configured file is authoritative: missing/keyless files never fall back to environment keys.
# Without a configured file, the shared OPENROUTER_API_KEY setting/environment is used.
# SELF_DIRECT_OPENROUTER_API_KEY_FILE=/path/to/authorized/.env

# AGY evidence roots are app-data directories containing brain/<UUID>/.../logs.
# Defaults cover Antigravity 2.0, CLI, and IDE under the current user's .gemini.
# SELF_DIRECT_AGY_APP_DATA_DIRS=["/path/to/antigravity-cli"]
# SELF_DIRECT_AGY_ENFORCEMENT=enforced

# Optional owner-approved workflow. Keep these paths outside agent write authority.
# TSUKKOMI_WORKFLOW_APPROVAL=/path/to/read-only/approval
# TSUKKOMI_WORKFLOW_STATE=/path/to/private/workflow-state
# TSUKKOMI_LEAN=/path/to/trusted/lean
# TSUKKOMI_BWRAP=/path/to/trusted/bwrap
# Workflow classification uses the same OpenRouter key settings above; no separate TypeSafe key.
# Pinned model: typesafe/jev-1.13; canonical response: typesafe/jev-1.13-20260917.
