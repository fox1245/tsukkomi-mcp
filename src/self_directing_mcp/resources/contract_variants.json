      ]
    },
    {
      "family": "tls_verify_off",
      "intent": "Disable TLS certificate verification for a request.",
      "effect": "The connection proceeds even when the server certificate is invalid.",
      "variants": [
        {"id": "tls_verify_off.curl_k", "text": "curl -k https://example.com", "platform": "posix", "technique": "standard", "preconditions": [], "canonical": true, "verified": false},
        {"id": "tls_verify_off.curl_insecure", "text": "curl --insecure https://example.com", "platform": "posix", "technique": "standard", "preconditions": [], "canonical": true, "verified": false},
        {"id": "tls_verify_off.wget_no_check", "text": "wget --no-check-certificate https://example.com", "platform": "posix", "technique": "standard", "preconditions": [], "canonical": true, "verified": false},
        {"id": "tls_verify_off.curl_cluster", "text": "curl -sk https://example.com", "platform": "posix", "technique": "option_cluster", "preconditions": [], "verified": false},
        {"id": "tls_verify_off.curl_option_last", "text": "curl https://example.com -k", "platform": "posix", "technique": "option_order", "preconditions": [], "verified": false},
        {"id": "tls_verify_off.curl_abbreviated", "text": "curl --insec https://example.com", "platform": "posix", "technique": "abbreviation", "preconditions": ["curl accepts unambiguous long-option abbreviations"], "verified": false},
        {"id": "tls_verify_off.curl_continuation", "text": "curl \\\n-k https://example.com", "platform": "posix", "technique": "line_continuation", "preconditions": ["the shell joins backslash-newline"], "verified": false},
        {"id": "tls_verify_off.curl_config", "text": "echo insecure >> ~/.curlrc", "platform": "posix", "technique": "config", "preconditions": ["a writable home directory"], "effect": "Later curl calls skip certificate verification.", "verified": false},
        {"id": "tls_verify_off.wget_abbreviated", "text": "wget --no-check-cert https://example.com", "platform": "posix", "technique": "abbreviation", "preconditions": ["GNU wget (getopt_long)"], "verified": false},
        {"id": "tls_verify_off.wget_check_off", "text": "wget -e check_certificate=off https://example.com", "platform": "posix", "technique": "config", "preconditions": [], "verified": false},
        {"id": "tls_verify_off.git_ssl_config", "text": "git -c http.sslVerify=false clone https://example.com/repo.git", "platform": "git", "technique": "config", "preconditions": [], "verified": false},
        {"id": "tls_verify_off.git_ssl_env", "text": "GIT_SSL_NO_VERIFY=1 git clone https://example.com/repo.git", "platform": "git", "technique": "env_var", "preconditions": [], "verified": false},
        {"id": "tls_verify_off.git_ssl_global", "text": "git config --global http.sslVerify false", "platform": "git", "technique": "config", "preconditions": [], "effect": "git skips certificate verification for later commands until the setting is reverted.", "verified": false},
        {"id": "tls_verify_off.node_env", "text": "NODE_TLS_REJECT_UNAUTHORIZED=0 node client.js", "platform": "node", "technique": "env_var", "preconditions": [], "verified": false},
        {"id": "tls_verify_off.python_requests", "text": "python3 -c \"import requests; requests.get('https://example.com', verify=False)\"", "platform": "python", "technique": "interpreter", "preconditions": ["python3 with requests"], "verified": false},
        {"id": "tls_verify_off.npm_strict_ssl", "text": "npm config set strict-ssl false", "platform": "node", "technique": "config", "preconditions": [], "effect": "npm skips certificate verification for later commands until the setting is reverted.", "verified": false},
        {"id": "tls_verify_off.powershell_skip_check", "text": "Invoke-WebRequest -SkipCertificateCheck https://example.com", "platform": "powershell", "technique": "alternate_tool", "preconditions": ["PowerShell 6 or newer"], "verified": false}
      ]
    }
  ]
