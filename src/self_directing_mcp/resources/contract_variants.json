        {"id": "world_writable.other_write", "text": "chmod o+w script.sh", "platform": "posix", "technique": "partial_mode", "preconditions": [], "effect": "Other users gain write permission; read and execute bits are unchanged.", "verified": false},
        {"id": "world_writable.mode_666", "text": "chmod 666 script.sh", "platform": "posix", "technique": "mode_spelling", "preconditions": [], "effect": "script.sh becomes readable and writable by all users, without an execute bit.", "verified": false},
