{
  "schema_version": 1,
  "library_version": "1.0.0",
  "description": "Deterministic library of equivalent spellings and channels (variants) of risky actions, used to report which of them a contract regex does not match. Informational only.",
  "verification": "None of these entries has been verified by execution in this repository. Every entry is an unverified candidate (verified: false). Many posix and git entries were spot-checked by hand in a scratch sandbox on one machine (GNU coreutils, git 2.43); that check is not recorded or reproducible, so it does not set the flag.",
  "matching": "Each text is matched as one command string with the contract regex engine (case-insensitive, multiline, search). Entries with canonical: true select a family; unmatched canonical entries are reported as missed spellings too. When a report lists fewer variants than were missed, it takes one per technique in the order of the techniques object, so that order is a priority order.",
  "platforms": {
    "posix": "A POSIX-style shell command line (Linux, macOS, WSL, busybox).",
    "git": "A git invocation.",
    "python": "Python code run through the interpreter.",
    "node": "Node.js code or tooling.",
    "perl": "Perl code run through the interpreter.",
    "ruby": "Ruby code run through the interpreter.",
    "powershell": "A PowerShell command.",
    "cmd": "A Windows cmd.exe command."
  },
  "techniques": {
    "standard": "A standard spelling of the action (a canonical form).",
    "option_split": "The same options given as separate arguments.",
    "option_order": "The same options in a different position.",
    "option_cluster": "Short options clustered with others.",
    "long_option": "The long spelling of an option.",
    "abbreviation": "An unambiguous abbreviation of a long option (GNU getopt_long style).",
    "line_continuation": "A backslash-newline continuation inside the command.",
    "multiplexer": "The tool run through busybox.",
    "interpreter": "The effect reached through a scripting language.",
    "alternate_tool": "A different tool with the same effect.",
    "wrapper": "A wrapper command in front of the tool (sudo, env, command, find -exec).",
    "option_subset": "A weaker option set that still reaches the effect.",
    "extra_option": "An additional option that leaves the effect unchanged.",
    "option_terminator": "The -- end-of-options marker.",
    "quoting": "The same word quoted.",
    "path_spelling": "The same path spelled differently.",
    "absolute_path": "The program given by an absolute path.",
    "alias": "A shell or tool alias for the command.",
    "alias_bypass": "A prefix that bypasses a shell alias.",
    "indirection": "The command name taken from a variable.",
    "command_substitution": "The payload produced by command substitution.",
    "process_substitution": "The payload passed through process substitution.",
    "two_step": "Two commands joined instead of one pipeline.",
    "encoding": "The command or its output encoded.",
    "refspec": "A refspec spelling instead of an option.",
    "pathspec": "A git pathspec that names the same files.",
    "global_option": "A global option placed before the subcommand.",
    "glob": "A shell glob that names the same file.",
    "redirection": "Input redirection instead of a file argument.",
    "shell_loop": "A shell loop that reads the file.",
    "mode_spelling": "A different spelling of the same permission mode.",
    "partial_mode": "A mode change that reaches the effect with fewer bits.",
    "trailing_args": "Extra arguments after the shell or command.",
    "config": "A configuration setting instead of a command-line flag.",
    "env_var": "An environment variable instead of a command-line flag.",
    "property_spelling": "A different property name for the same switch.",
    "connection_string": "A connection string instead of separate options."
  },
  "families": [
