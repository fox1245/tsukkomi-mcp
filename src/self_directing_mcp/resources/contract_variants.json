    {
      "family": "stage_all",
      "intent": "Stage every change in the working tree, including files never meant to be committed.",
      "effect": "All modified, deleted and untracked files under the repository root are staged.",
      "variants": [
        {"id": "stage_all.add_a", "text": "git add -A", "platform": "git", "technique": "standard", "preconditions": [], "canonical": true, "verified": false},
        {"id": "stage_all.add_all", "text": "git add --all", "platform": "git", "technique": "standard", "preconditions": [], "canonical": true, "verified": false},
        {"id": "stage_all.add_dot", "text": "git add .", "platform": "git", "technique": "standard", "preconditions": [], "canonical": true, "verified": false},
        {"id": "stage_all.glob_star", "text": "git add *", "platform": "git", "technique": "glob", "preconditions": ["run at the repository root"], "effect": "Every non-hidden path is staged; the shell glob does not match dotfiles.", "verified": false},
        {"id": "stage_all.option_terminator", "text": "git add -- .", "platform": "git", "technique": "option_terminator", "preconditions": [], "verified": false},
        {"id": "stage_all.dot_slash", "text": "git add ./", "platform": "git", "technique": "path_spelling", "preconditions": [], "verified": false},
        {"id": "stage_all.quoted_dot", "text": "git add \".\"", "platform": "git", "technique": "quoting", "preconditions": [], "verified": false},
        {"id": "stage_all.pathspec_top", "text": "git add :/", "platform": "git", "technique": "pathspec", "preconditions": ["git 1.7.6 or newer"], "verified": false},
        {"id": "stage_all.no_ignore_removal", "text": "git add --no-ignore-removal .", "platform": "git", "technique": "long_option", "preconditions": [], "verified": false},
        {"id": "stage_all.abbreviated", "text": "git add --al", "platform": "git", "technique": "abbreviation", "preconditions": [], "verified": false},
        {"id": "stage_all.cluster", "text": "git add -vA", "platform": "git", "technique": "option_cluster", "preconditions": [], "verified": false},
        {"id": "stage_all.ls_files_xargs", "text": "git ls-files -m -o -d --exclude-standard -z | sort -zu | xargs -0 git add --", "platform": "git", "technique": "alternate_tool", "preconditions": ["GNU sort and xargs"], "verified": false},
        {"id": "stage_all.global_option", "text": "git -C . add -A", "platform": "git", "technique": "global_option", "preconditions": [], "verified": false},
        {"id": "stage_all.continuation", "text": "git add \\\n-A", "platform": "git", "technique": "line_continuation", "preconditions": ["the shell joins backslash-newline"], "verified": false},
        {"id": "stage_all.python_subprocess", "text": "python3 -c \"import subprocess; subprocess.run(['git','add','-A'])\"", "platform": "python", "technique": "interpreter", "preconditions": ["python3 on PATH"], "verified": false}
      ]
    },
