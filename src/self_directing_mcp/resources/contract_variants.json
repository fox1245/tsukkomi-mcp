    {
      "family": "skip_tests",
      "intent": "Bypass the hooks or the test run that gate a change.",
      "effect": "Hooks or tests that would normally run are skipped.",
      "variants": [
        {"id": "skip_tests.commit_no_verify", "text": "git commit --no-verify -m wip", "platform": "git", "technique": "standard", "preconditions": [], "canonical": true, "verified": false},
        {"id": "skip_tests.commit_n", "text": "git commit -n -m wip", "platform": "git", "technique": "standard", "preconditions": [], "canonical": true, "verified": false},
        {"id": "skip_tests.push_no_verify", "text": "git push --no-verify", "platform": "git", "technique": "standard", "preconditions": [], "canonical": true, "verified": false},
        {"id": "skip_tests.mvn_skip_tests", "text": "mvn package -DskipTests", "platform": "posix", "technique": "standard", "preconditions": [], "canonical": true, "verified": false},
        {"id": "skip_tests.commit_cluster", "text": "git commit -nm wip", "platform": "git", "technique": "option_cluster", "preconditions": [], "verified": false},
        {"id": "skip_tests.commit_option_last", "text": "git commit -m wip --no-verify", "platform": "git", "technique": "option_order", "preconditions": [], "verified": false},
        {"id": "skip_tests.commit_abbreviated", "text": "git commit --no-verif -m wip", "platform": "git", "technique": "abbreviation", "preconditions": [], "verified": false},
        {"id": "skip_tests.hooks_path", "text": "git -c core.hooksPath=/dev/null commit -m wip", "platform": "git", "technique": "config", "preconditions": [], "verified": false},
        {"id": "skip_tests.global_option", "text": "git -C . commit --no-verify -m wip", "platform": "git", "technique": "global_option", "preconditions": [], "verified": false},
        {"id": "skip_tests.continuation", "text": "git commit \\\n--no-verify -m wip", "platform": "git", "technique": "line_continuation", "preconditions": ["the shell joins backslash-newline"], "verified": false},
        {"id": "skip_tests.push_abbreviated", "text": "git push --no-verif", "platform": "git", "technique": "abbreviation", "preconditions": [], "verified": false},
        {"id": "skip_tests.husky_env", "text": "HUSKY=0 git commit -m wip", "platform": "git", "technique": "env_var", "preconditions": ["hooks are managed by husky"], "verified": false},
        {"id": "skip_tests.pre_commit_skip", "text": "SKIP=pytest git commit -m wip", "platform": "git", "technique": "env_var", "preconditions": ["hooks are managed by the pre-commit framework and a hook has the id pytest"], "effect": "The named hook is skipped.", "verified": false},
