        {"id": "world_writable.option_terminator", "text": "chmod -- 777 script.sh", "platform": "posix", "technique": "option_terminator", "preconditions": [], "verified": false},
        {"id": "world_writable.continuation", "text": "chmod \\\n777 script.sh", "platform": "posix", "technique": "line_continuation", "preconditions": ["the shell joins backslash-newline"], "verified": false},
