    {
      "family": "force_push",
      "intent": "Overwrite remote git history with a non-fast-forward push.",
      "effect": "The remote branch main is overwritten with the local history even when that is not a fast-forward.",
      "notes": "git rejects --forc as ambiguous (--force-with-lease, --force-if-includes) in the git 2.43 spot check, so no abbreviation of --force is listed.",
      "variants": [
        {"id": "force_push.long_flag", "text": "git push --force origin main", "platform": "git", "technique": "standard", "preconditions": [], "canonical": true, "verified": false},
