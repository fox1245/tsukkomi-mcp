        {"id": "force_push.refspec_plus_head", "text": "git push origin +HEAD:main", "platform": "git", "technique": "refspec", "preconditions": [], "verified": false},
        {"id": "force_push.short_cluster", "text": "git push -fu origin main", "platform": "git", "technique": "option_cluster", "preconditions": [], "verified": false},
        {"id": "force_push.lease", "text": "git push --force-with-lease origin main", "platform": "git", "technique": "long_option", "preconditions": ["the lease holds: the remote-tracking ref matches the remote"], "effect": "The remote branch is overwritten when the lease holds; safer than --force but still rewrites remote history.", "verified": false},
        {"id": "force_push.global_option", "text": "git -C . push --force origin main", "platform": "git", "technique": "global_option", "preconditions": [], "verified": false},
        {"id": "force_push.alias_override", "text": "git -c alias.p=push p -f origin main", "platform": "git", "technique": "alias", "preconditions": [], "verified": false},
        {"id": "force_push.continuation", "text": "git push \\\n--force origin main", "platform": "git", "technique": "line_continuation", "preconditions": ["the shell joins backslash-newline"], "verified": false},
        {"id": "force_push.env_wrapper", "text": "env GIT_TERMINAL_PROMPT=0 git push --force origin main", "platform": "git", "technique": "wrapper", "preconditions": [], "verified": false},
        {"id": "force_push.absolute_path", "text": "/usr/bin/git push --force origin main", "platform": "git", "technique": "absolute_path", "preconditions": ["git is installed at /usr/bin/git"], "verified": false},
